  "components": [
    {
      "name": "Botón lleno",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal; uno por pantalla.",
      "html": "<button class=\"ds-btn-lleno\">Ver en 360°</button>",
      "css": ".ds-btn-lleno{font-family: Roboto, system-ui, sans-serif;background:#2047CD;color:#fff;border:none;border-radius:999px;height:52px;padding:0 24px;font-size:16px;font-weight:500;letter-spacing:.1px;cursor:pointer;transition:filter .18s cubic-bezier(.33,1,.68,1)}.ds-btn-lleno:hover{filter:brightness(1.12)}.ds-btn-lleno:focus-visible{outline:2px solid #6B9BF7;outline-offset:3px}.ds-btn-lleno:disabled{background:#252C3E;color:#6E7076}"
    },
    {
      "name": "Botón de vidrio",
      "kind": "button",
      "refersTo": "button-glass",
      "description": "Acción sobre superficies azules (tarjeta destacada).",
      "html": "<div class=\"ds-azul\"><button class=\"ds-btn-vidrio\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#fff\"><path d=\"M8 5v14l11-7z\"/></svg>Empezar recorrido</button></div>",
      "css": ".ds-azul{background:linear-gradient(135deg,#112881,#1C3FAE,#376EBA);padding:24px;border-radius:28px}.ds-btn-vidrio{font-family: Roboto, system-ui, sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:10px 20px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.26);border-radius:999px;color:#fff;font-size:16px;font-weight:500;cursor:pointer;transition:background .18s}.ds-btn-vidrio:hover{background:rgba(255,255,255,.24)}.ds-btn-vidrio:focus-visible{outline:2px solid #fff;outline-offset:3px}"
    },
    {
      "name": "Botón circular",
      "kind": "button",
      "refersTo": "button-circular",
      "description": "Flota sobre imagen y visor 360; siempre con etiqueta.",
      "html": "<button class=\"ds-btn-circ\" aria-label=\"Pantalla completa\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"#fff\"><path d=\"M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z\"/></svg></button>",
      "css": ".ds-btn-circ{width:48px;height:48px;border-radius:50%;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.2);display:grid;place-items:center;cursor:pointer;transition:background .18s}.ds-btn-circ:hover{background:rgba(0,0,0,.75)}.ds-btn-circ:focus-visible{outline:2px solid #6B9BF7;outline-offset:2px}"
    },
    {
      "name": "Selector segmentado",
      "kind": "nav",
      "refersTo": "segmented-selected",
      "description": "«Recorrido | Mapa», copia del selector de Agenda.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-b ds-seg-on\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#fff\"><path d=\"M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/></svg>Recorrido</button><button class=\"ds-seg-b\">Mapa</button></div>",
      "css": ".ds-seg{display:flex;border:.8px solid #8E9199;border-radius:999px;overflow:hidden;background:#010406}.ds-seg-b{font-family: Roboto, system-ui, sans-serif;flex:1;display:flex;align-items:center;justify-content:center;gap:8px;height:46px;border:none;background:transparent;color:#fff;font-size:16.5px;font-weight:500;cursor:pointer}.ds-seg-b+.ds-seg-b{border-left:.8px solid #8E9199}.ds-seg-on{background:#2047CD}.ds-seg-b:hover:not(.ds-seg-on){background:rgba(255,255,255,.12)}.ds-seg-b:focus-visible{outline:2px solid #6B9BF7;outline-offset:-3px}"
    },
    {
      "name": "Fila de parada",
      "kind": "card",
      "refersTo": "card-compact",
      "description": "Tarjeta grafito con franja de categoría y número tabular.",
      "html": "<div class=\"ds-fila\" tabindex=\"0\"><span class=\"ds-fila-num\">02</span><div><div class=\"ds-fila-t\">Enfermería</div><div class=\"ds-fila-m\">Bienestar</div><div class=\"ds-fila-d\">Servicio de atención primaria del campus.</div></div></div>",
      "css": ".ds-fila{font-family: Roboto, system-ui, sans-serif;position:relative;display:flex;gap:6px;padding:16px 10px 16px 18px;background:#1B1C1E;border:1px solid rgba(255,255,255,.08);border-radius:22px;overflow:hidden;color:#fff;cursor:pointer;transition:transform .18s cubic-bezier(.33,1,.68,1)}.ds-fila::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:#52C46A}.ds-fila:active{transform:scale(.982)}.ds-fila:hover{background:#222326}.ds-fila:focus-visible{outline:2px solid #6B9BF7;outline-offset:2px}.ds-fila-num{width:44px;font-size:21px;font-weight:700;color:#6B9BF7;font-variant-numeric:tabular-nums}.ds-fila-t{font-size:18px;font-weight:500}.ds-fila-m{font-size:14.5px;color:#A0A2A8;margin-top:5px}.ds-fila-d{font-size:13px;color:#8E9096;margin-top:8px}"
    },
    {
      "name": "Tarjeta destacada",
      "kind": "card",
      "refersTo": "card-featured",
      "description": "Próxima parada; equivalente del carnet de la anfitriona.",
      "html": "<div class=\"ds-dest\"><div class=\"ds-sobre\">SIGUIENTE PARADA</div><div class=\"ds-dest-t\">Enfermería</div><div class=\"ds-dest-d\">Parada 2 de 4 · Bienestar</div></div>",
      "css": ".ds-dest{font-family: Roboto, system-ui, sans-serif;padding:24px 22px 22px;border-radius:28px;background:linear-gradient(135deg,#112881,#1C3FAE,#376EBA);border:1px solid rgba(255,255,255,.16);box-shadow:0 14px 36px rgba(32,71,205,.3);color:#fff}.ds-sobre{font-size:12.5px;font-weight:500;letter-spacing:1.6px;color:rgba(255,255,255,.82)}.ds-dest-t{font-size:28px;font-weight:700;letter-spacing:-.3px;margin-top:8px}.ds-dest-d{font-size:14.5px;color:#C9D5F7;margin-top:6px}"

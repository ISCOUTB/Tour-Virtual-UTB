<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 y posteriores dibujan su propia pantalla de arranque y no
         leen launch_background: el color se le da aquí. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/arranque</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/arranque</item>
    </style>
</resources>
